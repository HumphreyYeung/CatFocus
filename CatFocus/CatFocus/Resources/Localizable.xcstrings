    "...Wait, is someone there?": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "…ん？ だれかいる？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "…잠깐, 누구 있어?"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "……咦，有人在嗎？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "...Wait, is someone there?"
          }
        }
      }
    },
    "\"THANK YOU FOR STAYING FOCUSED. I FEEL MUCH STRONGER NOW!\"": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「集中してくれてありがとう。わたし、ずっと強くなったよ！」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“집중해 줘서 고마워. 나, 훨씬 튼튼해졌어!”"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「謝謝你這麼專心，我覺得自己變強了好多！」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"THANK YOU FOR STAYING FOCUSED. I FEEL MUCH STRONGER NOW!\""
          }
        }
      },
      "extractionState": "manual"
    },
