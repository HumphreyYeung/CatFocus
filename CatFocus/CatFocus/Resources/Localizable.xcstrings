    "10 seconds and I already slimmed down a tiny bit. Imagine 25 minutes...": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たった10秒で、ちょっとすっきりした気がする。25分もやったら、どうなっちゃうんだろう…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10초밖에 안 됐는데 벌써 조금 날씬해진 것 같아. 25분이면 어떨까…"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "才 10 秒，我就覺得自己瘦了一點點。要是 25 分鐘，不知道會變怎樣……"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10 seconds and I already slimmed down a tiny bit. Imagine 25 minutes..."
          }
        }
      }
    },
