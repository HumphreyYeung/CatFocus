    "Your collection is safe. Renew to receive new mail.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集めたお手紙はそのまま大切に保管されています。再開すると、新しいお手紙が届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모은 편지는 안전하게 보관돼요. 다시 구독하면 새 편지를 받을 수 있어요."
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你收藏的信件都會好好保留；重新訂閱後，就能收到新的來信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your collection is safe. Renew to receive new mail."
          }
        }
      },
      "extractionState": "manual"
    },
