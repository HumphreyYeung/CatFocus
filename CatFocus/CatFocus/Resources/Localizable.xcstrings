    "Okay... confession. I can't stop eating. Maybe I need a training partner. What's your name?": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "えっと…白状します。つい食べすぎちゃうの。一緒にトレーニングしてくれる子がいたらなあ。あなたのお名前は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음… 솔직히 말할게. 자꾸 먹게 돼. 같이 운동할 친구가 있으면 좋겠다. 이름이 뭐야?"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "好吧……我承認，我就是停不下來一直吃。也許我需要一個一起訓練的夥伴。你叫什麼名字呀？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay... confession. I can't stop eating. Maybe I need a training partner. What's your name?"
          }
        }
      }
    },
