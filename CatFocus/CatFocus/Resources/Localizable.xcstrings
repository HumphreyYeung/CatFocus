    "%lld more active days until the next letter.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lld日集中すると、次のお手紙が届くよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일 더 집중하면 다음 편지를 받을 수 있어요."
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "再專注 %lld 天，就能收到下一封來信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld more active days until the next letter."
          }
        }
