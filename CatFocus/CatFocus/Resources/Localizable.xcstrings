    "Luna is feeling the burn. That workout paid off. You're both getting stronger.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルナもいい汗をかいたみたい。頑張った分だけ、ふたりとも強くなっているよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루나도 열심히 운동했어요. 함께한 시간이 힘이 됐네요. 둘 다 조금씩 더 튼튼해지고 있어요."
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna 也練得熱呼呼的。這次努力沒有白費，你們都變得更強了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna is feeling the burn. That workout paid off. You're both getting stronger."
          }
        }
      }
    },
