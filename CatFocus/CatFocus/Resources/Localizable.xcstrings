    "Luna got a little discouraged, but you can still restart together.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルナはちょっぴりしょんぼり。でも、また一緒にはじめられるよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루나가 조금 시무룩해졌어요. 괜찮아요, 함께 다시 시작하면 돼요."
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna 有一點點失落，不過沒關係，你們隨時都能一起重新開始。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna got a little discouraged, but you can still restart together."
          }
        }
      }
    },
