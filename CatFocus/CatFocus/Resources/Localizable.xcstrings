    "• I show up fully for each session.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 毎回、心をこめて集中します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "• 매 세션에 온전히 집중할게요."
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "• 每一次專注，我都會全心投入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• I show up fully for each session."
          }
        }
      },
      "extractionState": "manual"
    },
    "• Luna's strength is in my hands.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• ルナの元気を、わたしが育てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "• 루나의 힘을 내가 키워 줄게요."
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "• Luna 的成長，由我陪她一起努力。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Luna's strength is in my hands."
          }
        }
      },
      "extractionState": "manual"
    },
