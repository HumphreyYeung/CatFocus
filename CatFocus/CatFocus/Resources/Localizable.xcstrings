    "1 more active day until the next letter.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと1日集中すると、次のお手紙が届くよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루만 더 집중하면 다음 편지를 받을 수 있어요."
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "再專注 1 天，就能收到下一封來信。"
