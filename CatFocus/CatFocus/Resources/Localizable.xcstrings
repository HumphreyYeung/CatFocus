    "You keep showing up and I will keep writing. This is our little pact...": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたがここに来てくれるなら、わたしはずっとお手紙を書くね。これが、ふたりの小さな約束…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네가 계속 함께해 주면 나도 계속 편지를 쓸게. 이건 우리만의 작은 약속이야…"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只要你一直來陪我，我就會一直寫信。這是屬於我們的小小約定……"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You keep showing up and I will keep writing. This is our little pact..."
          }
        }
      },
      "extractionState": "manual"
    },
